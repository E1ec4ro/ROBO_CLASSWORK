<?xml version="1.0"?>
<robot name="simple_robot">
  
  <!-- Базовые параметры (корпус приподнят над землёй и шире, но не касается колёс) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <!-- Корпус шире, но не касается колёс:
             длина X=0.4, ширина Y=0.28, высота Z=0.1
             (колёса на Y=±0.27, радиус 0.1 => остаётся зазор ~0.03 м) -->
        <box size="0.4 0.28 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.28 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10"/>
      <!-- Немного увеличили моменты инерции из-за более широкой базы -->
      <inertia ixx="0.07" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.09"/>
    </inertial>
  </link>

  <!-- Левое колесо -->
  <link name="left_wheel">
    <!-- Внешняя часть колеса (чёрная) -->
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <!-- Внутренняя часть колеса (белая) для наглядного вращения -->
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.051"/>
      </geometry>
      <material name="white_left">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Правое колесо -->
  <link name="right_wheel">
    <!-- Внешняя часть колеса (чёрная) -->
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <!-- Внутренняя часть колеса (белая) для наглядного вращения -->
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.051"/>
      </geometry>
      <material name="white_right">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Соединение левого колеса -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <!-- Колёса вынесены дальше от корпуса по оси Y -->
    <origin xyz="0 0.27 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Соединение правого колеса -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.27 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Переднее опорное колесо (кастер) -->
  <link name="front_caster">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
      <material name="grey_caster">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Шарнир переднего опорного колеса: свободно поворачивается вокруг оси Z -->
  <joint name="front_caster_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <!-- Смещаем кастер вперёд по X и чуть вниз, чтобы касаться пола -->
    <origin xyz="0.18 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Gazebo плагины -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <!-- ROS параметры -->
      <ros>
        <namespace>/</namespace>
      </ros>
      <!-- Топик для команд движения -->
      <commandTopic>cmd_vel</commandTopic>
      <!-- Топик для одометрии -->
      <odometryTopic>odom</odometryTopic>
      <!-- Параметры колес -->
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>
      <!-- Расстояние между центрами колёс (0.27 - (-0.27)) -->
      <wheelSeparation>0.54</wheelSeparation>
      <wheelDiameter>0.2</wheelDiameter>
      <!-- Ограничения скорости и ускорения -->
      <wheelTorque>20</wheelTorque>
      <wheelAcceleration>1.0</wheelAcceleration>
      <!-- Публикация данных -->
      <publishOdom>true</publishOdom>
      <publishOdomTF>true</publishOdomTF>
      <publishWheelTF>true</publishWheelTF>
      <!-- Системы координат -->
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_link</robotBaseFrame>
      <!-- Частота обновления -->
      <updateRate>20</updateRate>
    </plugin>
  </gazebo>

</robot>

